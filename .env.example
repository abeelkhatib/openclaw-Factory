# App
APP_ENV=local

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/openclaw

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pipeline-task-queue

# Worker behavior
FAIL_MODE=0

# Gate B webhooks
N8N_STATUS_WEBHOOK_URL=http://localhost:5678/webhook/status
N8N_EXCEPTIONS_WEBHOOK_URL=http://localhost:5678/webhook/exceptions

# API
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=3000

# Plan validator
PLAN_VALIDATOR_HOST=0.0.0.0
PLAN_VALIDATOR_PORT=3001
